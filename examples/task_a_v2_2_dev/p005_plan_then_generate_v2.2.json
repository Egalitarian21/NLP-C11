            "s004",
            "s007"
          ]
        },
        {
          "line_id": "line_3",
          "speaker_id": "c1",
          "text": "That sounds fun, but I love nature. Is there a club for that?",
          "emotion": "happy",
          "action": "none",
          "source_sentence_ids": [
            "s014"
          ]
        },
        {
          "line_id": "line_4",
          "speaker_id": "c2",
          "text": "Yes! The nature club goes hiking every Sunday afternoon. They watch birds and collect plants and insects.",
          "emotion": "excited",
          "action": "point",
          "source_sentence_ids": [
            "s016",
            "s017"
          ]
        },
        {
          "line_id": "line_5",
          "speaker_id": "c1",
          "text": "I want to discover wildlife! Let's try the nature club first.",
          "emotion": "excited",
          "action": "nod",
          "source_sentence_ids": [
            "s019"
          ]
        }
      ]
    },
    {
      "scene_id": "scene_2",
      "location": "Nature park",
      "dialogue": [
        {
          "line_id": "line_6",
          "speaker_id": "c1",
          "text": "I'm not sure what to look for. Maybe we won't find anything.",
